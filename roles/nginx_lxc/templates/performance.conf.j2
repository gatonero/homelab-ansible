# --------------------------------------------------
# HTTP performance tuning (conf.d safe)
# --------------------------------------------------

sendfile on;
tcp_nopush on;
tcp_nodelay on;

keepalive_timeout 65;
keepalive_requests 1000;

client_body_timeout 30s;
client_header_timeout 30s;
send_timeout 30s;

proxy_connect_timeout 30s;
proxy_send_timeout 300s;
proxy_read_timeout 300s;

reset_timedout_connection on;

# gzip (safe defaults)
gzip on;
gzip_disable "msie6";
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_types
  text/plain
  text/css
  application/json
  application/javascript
  text/xml
  application/xml
  application/xml+rss
  text/javascript;
